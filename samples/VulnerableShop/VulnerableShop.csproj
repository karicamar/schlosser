<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A deliberately vulnerable shop. Every file in Vulnerable/ has a twin in Fixed/ that does the same job safely.
    Building this project prints the Schlosser findings; tools/check-sample.mjs compares them with expected-findings.txt.
    Do not deploy it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- SARIF for GitHub Code Scanning and for the check script -->
    <ErrorLog>obj/schlosser.sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <!-- In a real project: <PackageReference Include="Schlosser.Analyzers" Version="1.0.0" PrivateAssets="all" /> -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Schlosser.Analyzers\Schlosser.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
