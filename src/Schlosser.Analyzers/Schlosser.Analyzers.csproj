<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers are loaded by the compiler (also inside Visual Studio on .NET Framework), so netstandard2.0 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- RS2008: release tracking files are not used; docs/rules.md is the rule list -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <RootNamespace>Schlosser</RootNamespace>

    <!-- NuGet package: dotnet add package Schlosser.Analyzers -->
    <PackageId>Schlosser.Analyzers</PackageId>
    <Version>1.0.0</Version>
    <Authors>Amar Karic</Authors>
    <Description>Security analyzers for C# and ASP.NET Core: follows request data into SQL, shell commands, file paths, redirects and outgoing HTTP calls across method and class boundaries; weak cryptography, hard-coded secrets, disabled certificate and JWT validation, insecure deserialization, XXE, cookie flags, CORS. With code fixes.</Description>
    <PackageTags>security;analyzers;roslyn;sast;aspnetcore;owasp;sql-injection;taint-analysis</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karicamar/schlosser</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The package carries both DLLs: the analyzers and the code fixes -->
  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)Schlosser.Analyzers.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\Schlosser.CodeFixes\bin\$(Configuration)\netstandard2.0\Schlosser.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
